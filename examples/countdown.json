{
  "schema_version": 1,
  "name": "countdown",
  "entry_function": "main",
  "functions": [
    {
      "name": "main",
      "parameters": [],
      "entry_block": "entry",
      "blocks": [
        {"name": "entry", "operations": [
          {"op": "read_a", "destination": "n"},
          {"op": "jump", "target": "test"}
        ]},
        {"name": "test", "operations": [
          {"op": "branch_zero", "value": "n", "zero_target": "done", "nonzero_target": "step"}
        ]},
        {"name": "step", "operations": [
          {"op": "write_a", "value": "n"},
          {"op": "sub", "destination": "n", "left": "n", "right": 1},
          {"op": "jump", "target": "test"}
        ]},
        {"name": "done", "operations": [
          {"op": "write_a", "value": "n"},
          {"op": "halt"}
        ]}
      ]
    }
  ],
  "cases": [
